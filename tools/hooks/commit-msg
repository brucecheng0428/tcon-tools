#!/bin/sh
# commit-msg：過期 index 防線第二道（P105，2026-10-05）。
#   pre-commit 擋「刪掉仍在工作區的檔」；這裡擋「把檔案退回較舊的已提交版本」，
#   並在通過後於 commit message 加上 trailer「Guard-Checked: tcon-hooks」。
#   GitHub 上的 history-guard workflow 用同一支 tools/guard/history_guard.py 再檢查一次；
#   沒有這個 trailer 的 commit ＝ 沒裝 hook 或用了 --no-verify，會在 GitHub 上被標出。
#   刻意退版：commit message 寫「Allow-Revert: <原因>」；刻意大量刪除：「Allow-Mass-Delete: <原因>」。
#   檢查跑不起來（rc=2）不當作通過。
REPO="$(git rev-parse --show-toplevel)"
G="$REPO/tools/guard/history_guard.py"
if [ ! -f "$G" ]; then
  echo "🛑 找不到 $G —— 退版檢查無法執行，commit 已中止。"
  exit 1
fi
python3 "$G" --staged --msg-file "$1"
rc=$?
if [ $rc -eq 1 ]; then
  echo "🛑 退版／大量刪除檢查不通過，commit 已中止。"
  exit 1
fi
if [ $rc -ne 0 ]; then
  echo "🛑 退版檢查跑不起來（rc=$rc），commit 已中止 —— 檢查失效不當作通過。"
  exit 1
fi
# 人名檢查（Bruce 2026-10-22）：commit message 與這次新增的內容不可有同事／客戶人名（同一份雜湊名單，見 tools/check_commit_names.mjs）。
#   GitHub 上的 name-guard workflow 用同一支再檢查一次；檢查跑不起來（rc=2、找不到 node）不當作通過。
NODE="$(command -v node 2>/dev/null || true)"
for _n in "$HOME/.local/node/bin/node" /opt/homebrew/bin/node /usr/local/bin/node; do
  [ -z "$NODE" ] && [ -x "$_n" ] && NODE="$_n"
done
if [ -z "$NODE" ]; then
  echo "🛑 找不到 node —— 人名檢查無法執行，commit 已中止。"
  exit 1
fi
"$NODE" "$REPO/tools/check_commit_names.mjs" --msg-file "$1" --staged
nrc=$?
if [ $nrc -ne 0 ]; then
  echo "🛑 人名檢查不通過（rc=$nrc），commit 已中止 —— 改寫成中性稱呼（同事、客戶 RD、原廠 FAE），不要用 --no-verify。"
  exit 1
fi
git interpret-trailers --in-place --if-exists replace --trailer "Guard-Checked: tcon-hooks" "$1" || {
  echo "🛑 無法寫入 Guard-Checked trailer，commit 已中止。"; exit 1; }
exit 0
